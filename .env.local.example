# Firebase Client (public — safe to expose in browser)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# Firebase Admin (server-side only — keep secret)
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# AI (Gemini)
GEMINI_API_KEY=
# Optional per-user daily caps on generation calls (defaults: 40 / 10)
AI_DAILY_LIMIT_PARENT=
AI_DAILY_LIMIT_CHILD=

# Database (PostgreSQL via Supabase)
DATABASE_URL=            # pooled connection string
DIRECT_URL=              # direct connection string (migrations)

# Email (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=       # e.g. hello@hiveexcel.com

# App
NEXT_PUBLIC_APP_URL=     # e.g. https://hiveexcel.com (used in email links)
ADMIN_EMAILS=            # comma-separated admin account emails
CRON_SECRET=             # bearer token Vercel Cron sends to /api/reports/weekly
